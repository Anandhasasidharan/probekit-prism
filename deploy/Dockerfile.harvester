# ProbeKit harvester image (batch activation collection)
FROM python:3.12-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./
COPY packages ./packages
COPY config.yaml ./

RUN uv sync --frozen --all-packages --no-dev --compile-bytecode

ENV PATH="/app/.venv/bin:$PATH"
ENV PROBEKIT_CONFIG=/app/config.yaml
ENV HF_HOME=/app/data/hf-cache

VOLUME ["/app/data"]

# Harvest runs as a one-shot job: mount a prompts JSONL at /app/data/prompts.jsonl
CMD ["probekit", "harvest", "--prompts", "/app/data/prompts.jsonl", \
     "--output", "/app/data/activations/harvest.parquet"]
